#!/usr/bin/env bash
# Valve's own ARM64 updater manages the client after the initial bootstrap.
set -euo pipefail
root="$HOME/.local/share/Steam"
if [[ ! -x "$root/steamrtarm64/steam" ]]; then
    /usr/libexec/steam-arm64-bootstrap
fi
mkdir -p "$HOME/.steam" "$root/package"
for name in steam root; do
    if [[ -e "$HOME/.steam/$name" && ! -L "$HOME/.steam/$name" ]]; then
        echo "Refusing to replace existing $HOME/.steam/$name" >&2
        exit 1
    fi
    ln -sfn "$root" "$HOME/.steam/$name"
done
# The native client bypasses upstream steam.sh, so establish its SDK paths.
for mapping in sdkarm64:linuxarm64 sdk64:linux64 sdk32:linux32 bin64:steamrt64 bin32:ubuntu12_32; do
    name=${mapping%%:*}
    target=${mapping#*:}
    if [[ -e "$HOME/.steam/$name" && ! -L "$HOME/.steam/$name" ]]; then
        echo "Refusing to replace existing $HOME/.steam/$name" >&2
        exit 1
    fi
    ln -sfn "$root/$target" "$HOME/.steam/$name"
done
if [[ ! -e "$root/package/beta" ]]; then
    printf '%s\n' steamdeck_stable > "$root/package/beta"
fi
# Older x86 Proton uses FEX and needs a real x86 Linux userspace.
mkdir -p "$HOME/.local/share/steamac"
nohup /usr/libexec/steamac-prepare-fex-rootfs > "$HOME/.local/share/steamac/rootfs-install.log" 2>&1 < /dev/null &
export FEX_ROOTFS="$HOME/.local/share/steamac/fex-rootfs"
# The upstream steam.sh still defaults to an x86 bootstrap. Use the actual
# native client and its native libraries, letting the updater refresh them.
export LD_LIBRARY_PATH="$root/steamrtarm64:$root/steamrtarm64/libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export MESA_LOADER_DRIVER_OVERRIDE="${MESA_LOADER_DRIVER_OVERRIDE:-zink}"
cd "$root"
for _ in 1 2 3; do
    status=0
    "$root/steamrtarm64/steam" "$@" || status=$?
    if [[ $status != 42 ]]; then
        exit "$status"
    fi
done
echo 'Steam requested too many updater restarts; start it again to retry.' >&2
exit 1
